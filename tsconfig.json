{
  "compilerOptions": {
    "sourceMap": true,
    "target": "es5",
    "types": ["jquery"],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "es2015"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es6",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "incremental": true
  },
  "files": [
    "public/main.ts",
    "public/gameLogic.ts",
    "public/metaLogic.ts",
    "public/gameUI.ts",
    "public/metaUI.ts",
    "public/cardRendering.ts",
    "public/data/index.ts",
    "public/data/encounters.ts",
    "public/data/relics.ts",
    "public/data/potions.ts",
    "public/data/boons.ts",
    "public/data/victory.ts",
  ]
}
