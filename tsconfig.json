{
  "compilerOptions": {
    "outDir": "public",
    "rootDir": ".",
    "sourceMap": true,
    "target": "es5",
    "types": ["jquery"],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "es2015"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es6",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "incremental": true
  },
  "files": [
    "main.ts",
    "gameLogic.ts",
    "metaLogic.ts",
    "gameUI.ts",
    "metaUI.ts",
    "cardRendering.ts",
    "data/index.ts",
    "data/encounters.ts",
    "data/relics.ts",
    "data/potions.ts",
    "data/boons.ts",
    "data/victory.ts"
  ]
}
